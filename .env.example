NAISKOS_HOST=127.0.0.1
NAISKOS_PORT=8090
NAISKOS_PUBLIC_URL=https://naiskos.example.com
DATABASE_URL=postgresql://naiskos_app:CHANGE_ME@127.0.0.1:5432/naiskos
# Sólo para la CLI de aprovisionamiento; si falta, usa DATABASE_URL.
NAISKOS_ADMIN_DATABASE_URL=postgresql://naiskos_app:CHANGE_ME@127.0.0.1:5432/naiskos
NAISKOS_DB_POOL_MAX=10
NAISKOS_STORAGE_ROOT=/var/lib/naiskos-server/storage
NAISKOS_TRUSTED_PROXIES=127.0.0.1
# Se comparte con la imagen de instalación; permite el alta automática del hardware.
NAISKOS_DEVICE_BOOTSTRAP_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_BASE=http://127.0.0.1:8092
TELEGRAM_ADMIN_IDS=
NAISKOS_TELEGRAM_BOT_USERNAME=naiskosbot
NAISKOS_WORKER_INTERVAL_MS=1000
NAISKOS_WORKER_LOCK_TIMEOUT_SECONDS=900
NAISKOS_ORIGINAL_RETENTION_DAYS=7
NAISKOS_TRASH_RETENTION_DAYS=30
# Base local descargada y actualizada fuera de las releases.
NAISKOS_GEOLITE_DATABASE_PATH=/var/lib/naiskos-server/geoip/GeoLite2-City.mmdb
# Secreto exclusivo del servidor central; nunca se entrega al agente ni a Angular.
GOOGLE_GEOLOCATION_API_KEY=
NAISKOS_GOOGLE_GEOLOCATION_API_URL=https://www.googleapis.com/geolocation/v1/geolocate
NAISKOS_GOOGLE_GEOLOCATION_MAX_ACCURACY_METERS=25000
NAISKOS_LOCATION_REFRESH_MS=86400000
NAISKOS_LOCATION_FAILURE_COOLDOWN_MS=3600000
NAISKOS_WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
NAISKOS_WEATHER_REFRESH_MS=900000
NAISKOS_WEATHER_STALE_MS=21600000
NAISKOS_WEATHER_FAILURE_COOLDOWN_MS=300000
NAISKOS_EXTERNAL_REQUEST_TIMEOUT_MS=8000
# Repeticiones posteriores al intento inicial. El mínimo permitido es 3.
NAISKOS_EXTERNAL_RETRY_COUNT=3
NAISKOS_GEOLOCATION_MAX_ACCURACY_RADIUS_KM=100
# Sólo para geoipupdate; no son consumidas por la API.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
