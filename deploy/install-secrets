#!/usr/bin/env bash
set -euo pipefail

deploy_root="${NAISKOS_DEPLOY_ROOT:-/opt/naiskos-server}"
secrets_dir="${deploy_root}/shared/secrets"
server_env="${secrets_dir}/server.env"
bot_api_env="${secrets_dir}/bot-api.env"
service_host="${NAISKOS_HOST:-127.0.0.1}"
service_port="${NAISKOS_PORT:-8090}"
public_url="${NAISKOS_PUBLIC_URL:-http://127.0.0.1:${service_port}}"
storage_root="${NAISKOS_STORAGE_ROOT:-${deploy_root}/shared/storage}"
trusted_proxies="${NAISKOS_TRUSTED_PROXIES:-127.0.0.1}"
telegram_api_base="${TELEGRAM_API_BASE:-http://127.0.0.1:8092}"
telegram_bot_username="${NAISKOS_TELEGRAM_BOT_USERNAME:-naiskosbot}"

if [[ -e "$server_env" || -e "$bot_api_env" ]]; then
  echo "Ya existe al menos un archivo de secretos; no se sobrescribió nada." >&2
  exit 1
fi

read -r -s -p "Bot token de @naiskosbot: " bot_token
echo
read -r -s -p "Telegram api_id: " api_id
echo
read -r -s -p "Telegram api_hash: " api_hash
echo
read -r -s -p "DATABASE_URL de naiskos_app: " database_url
echo
read -r -p "Telegram user ID administrador: " admin_id

if [[ ! "$bot_token" =~ ^[0-9]+:[A-Za-z0-9_-]{20,}$ ]]; then
  echo "El bot token no tiene el formato esperado." >&2
  exit 1
fi
if [[ ! "$api_id" =~ ^[1-9][0-9]*$ ]]; then
  echo "api_id debe ser numérico." >&2
  exit 1
fi
if [[ ! "$api_hash" =~ ^[A-Fa-f0-9]{32}$ ]]; then
  echo "api_hash no tiene el formato esperado." >&2
  exit 1
fi
if [[ ! "$database_url" =~ ^postgres(ql)?:// ]]; then
  echo "DATABASE_URL no es una URL PostgreSQL." >&2
  exit 1
fi
if [[ ! "$admin_id" =~ ^[1-9][0-9]*$ ]]; then
  echo "El Telegram user ID debe ser numérico." >&2
  exit 1
fi
for value in "$bot_token" "$api_hash" "$database_url"; do
  if [[ "$value" == *$'\n'* || "$value" == *"'"* ]]; then
    echo "Un secreto contiene un carácter no admitido por este instalador." >&2
    exit 1
  fi
done

webhook_secret="$(openssl rand -hex 32)"
umask 077
mkdir -p "$secrets_dir"
chmod 0700 "$secrets_dir"
server_tmp="$(mktemp "${secrets_dir}/server.env.XXXXXX")"
bot_tmp="$(mktemp "${secrets_dir}/bot-api.env.XXXXXX")"
trap 'rm -f "$server_tmp" "$bot_tmp"' EXIT

printf '%s\n' \
  "NAISKOS_HOST=${service_host}" \
  "NAISKOS_PORT=${service_port}" \
  "NAISKOS_PUBLIC_URL=${public_url}" \
  "DATABASE_URL='${database_url}'" \
  "NAISKOS_DB_POOL_MAX=4" \
  "NAISKOS_STORAGE_ROOT=${storage_root}" \
  "NAISKOS_TRUSTED_PROXIES=${trusted_proxies}" \
  "TELEGRAM_BOT_TOKEN='${bot_token}'" \
  "TELEGRAM_WEBHOOK_SECRET=${webhook_secret}" \
  "TELEGRAM_API_BASE=${telegram_api_base}" \
  "TELEGRAM_ADMIN_IDS=${admin_id}" \
  "NAISKOS_TELEGRAM_BOT_USERNAME=${telegram_bot_username}" \
  "NAISKOS_WORKER_INTERVAL_MS=1000" \
  "NAISKOS_ORIGINAL_RETENTION_DAYS=7" \
  "NAISKOS_TRASH_RETENTION_DAYS=30" >"$server_tmp"

printf '%s\n' \
  "TELEGRAM_API_ID=${api_id}" \
  "TELEGRAM_API_HASH='${api_hash}'" >"$bot_tmp"

chmod 0600 "$server_tmp" "$bot_tmp"
mv "$server_tmp" "$server_env"
mv "$bot_tmp" "$bot_api_env"
trap - EXIT
unset bot_token api_hash database_url webhook_secret

echo "Secretos instalados con modo 0600 en ${secrets_dir}."
